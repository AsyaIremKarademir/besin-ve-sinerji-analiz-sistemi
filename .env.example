# Bu dosyayı ".env" adıyla kopyalayıp değerleri kendi ortamınıza göre düzenleyin.
# ".env" dosyası .gitignore ile depo dışında tutulur; gerçek anahtarları buraya YAZMAYIN.

# SQLite veri tabanı dosyasının yolu (proje köküne göre)
BESIN_DB_PATH=data/besin_sinerji.db

# USDA FoodData Central API anahtarı (isteğe bağlı; ilk sürüm yerel veri setiyle çalışır)
# Anahtar almak için: https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=

# Analiz geçmişinin saklanması (FR-7). Kullanıcı izni olmadan "false" kalmalıdır.
SAVE_HISTORY=false

# Günlük kayıt seviyesi: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
